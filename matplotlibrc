# Study pipeline: enforced figure house style (auto-loaded baseline)
figure.figsize: 7, 4.5
figure.dpi: 150
# constrained_layout is matplotlib's robust layout engine — it auto-spaces ticks, axis labels,
# legends and subplots so text/labels don't overlap or clip (tight_layout often fails to). Applied
# as a baseline so EVERY figure benefits regardless of the generated code. The pads give a little
# extra breathing room around long rotated tick labels and outside legends.
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.06
figure.constrained_layout.w_pad: 0.06
figure.constrained_layout.hspace: 0.04
figure.constrained_layout.wspace: 0.04
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.05
font.size: 12
font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Helvetica, sans-serif
axes.titlesize: 14
axes.titleweight: bold
axes.labelsize: 12
xtick.labelsize: 11
ytick.labelsize: 11
legend.fontsize: 11
legend.frameon: False
axes.grid: True
axes.axisbelow: True
grid.alpha: 0.30
grid.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.edgecolor: 444444
axes.linewidth: 1.0
lines.linewidth: 2.0
lines.markersize: 6
image.cmap: viridis
axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', 'CC79A7', '56B4E9', 'F0E442', '000000'])
